TELEGRAM_BOT_TOKEN=your_bot_token_here
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192
HISTORY_TURNS=8
MAX_CHATS=100
MAX_CONCURRENT_CHATS=2
SYSTEM_PROMPT=You are a helpful assistant. Reply in the user's language, clearly and concisely.
# Optional HTTP proxy for Telegram only; empty uses OS/environment proxy settings.
# Example: http://127.0.0.1:8080
TELEGRAM_PROXY_URL=

# Personal-account secretary through Telegram Business (optional)
BUSINESS_MODE=false
OWNER_USER_ID=
SECRETARY_PROFILE=secretary.json
SECRETARY_DATABASE=data/secretary.sqlite3
# PostgreSQL storage for secretary data; blank keeps the existing SQLite store.
# Create the database first. Percent-encode reserved characters in the password.
DATABASE_URL=
# Example: postgresql://hexbot:YOUR_PASSWORD@127.0.0.1:5432/hexbot
MESSAGE_BATCH_SECONDS=3

# Optional owner account connection for reading the actual previous 300 messages.
# Run history_login.py locally once after installing requirements-history.txt.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=data/history-account
# Separate MTProto proxy, if needed: socks5://127.0.0.1:1080
HISTORY_PROXY_URL=
