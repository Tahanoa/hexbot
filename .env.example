TELEGRAM_BOT_TOKEN=your_bot_token_here
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
HISTORY_TURNS=8
MAX_CHATS=100
MAX_CONCURRENT_CHATS=2
# Empty means all users can access the bot in private chats.
ALLOWED_USER_IDS=
SYSTEM_PROMPT=You are a helpful assistant. Reply in the user's language, clearly and concisely.
# Optional HTTP proxy for Telegram only, e.g. http://127.0.0.1:8080
TELEGRAM_PROXY_URL=
