TELEGRAM_BOT_TOKEN=your_bot_token_here
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OLLAMA_NUM_CTX=8192
HISTORY_TURNS=8
MAX_CHATS=100
MAX_CONCURRENT_CHATS=2
SYSTEM_PROMPT=You are a helpful assistant. Reply in the user's language, clearly and concisely.
# Optional HTTP proxy for Telegram only; empty uses OS/environment proxy settings.
# Example: http://127.0.0.1:8080
TELEGRAM_PROXY_URL=

# Personal-account secretary through Telegram Business (optional)
BUSINESS_MODE=false
OWNER_USER_ID=
SECRETARY_PROFILE=secretary.json
SECRETARY_DATABASE=data/secretary.sqlite3
